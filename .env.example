# =============================================================================
# MONOFORM environment variables
# =============================================================================
#
# Copy this file to `.env.local` and fill in the values for your local
# environment. Never commit `.env.local` or any file containing real
# credentials.
#
# Conventions used in this file
# -----------------------------
# - Lines beginning with `#` are comments.
# - Every variable documents its expected shape, its `server-only` vs
#   `browser-safe` classification, and the placeholder value that
#   preflight / runtime checks use to flag an unconfigured deployment.
# - When a value below looks like a placeholder (matches one of the
#   tokens the preflight script tracks — `anon-key`, `publishable-key`,
#   `service-role-key`, `re_xxx`, `https://your-project.supabase.co`,
#   `STORE_ORDER_NOTIFICATION_EMAIL_PLACEHOLDER`,
#   `RESEND_FROM_PLACEHOLDER`) the preflight script will warn that the
#   value still needs to be replaced.
#
# Loading order in development
# ----------------------------
# The preflight script (`npm run preflight`) loads this file (and
# `.env.local`) through `@next/env` so the same precedence rules that
# Next.js applies at build time also apply to the preflight report.
# Next.js itself loads `.env.local` automatically for `npm run dev` /
# `npm run build` / server actions; the preflight is the only place
# we have to wire the loader manually.

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public URL of the storefront. Used to build absolute callback URLs
# for Supabase email flows (verification, password recovery). Safe to
# expose to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — public (browser-safe) credentials
# -----------------------------------------------------------------------------
# The Supabase project URL and the publishable token. Both are safe
# to embed in the browser bundle. The service-role key (further down)
# is the privileged counterpart and is NEVER exposed.
#
# Two variable names are accepted for the public key:
#
#   * `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` — canonical, set this.
#   * `NEXT_PUBLIC_SUPABASE_ANON_KEY`       — legacy, accepted as
#                                             fallback only.
#
# When both are set the publishable key wins.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key  # legacy fallback; uncomment if needed

# -----------------------------------------------------------------------------
# Supabase — service-role key (server-only)
# -----------------------------------------------------------------------------
# Privileged key that the order backend uses to write orders,
# notification outbox rows, status history and admin allowlist
# queries. The application never imports this value from a "use
# client" file, never logs it, never sends it to the browser, and
# refuses to construct a public client if a value that looks like a
# service-role key is supplied through the public env vars.
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# -----------------------------------------------------------------------------
# Order notifications — store owner
# -----------------------------------------------------------------------------
# The order backend commits the order and its line items first, then
# writes a `pending` row to the `order_notifications` outbox. When
# this variable is set, the notification pipeline will attempt to
# deliver an email to it (subject to Resend configuration below).
#
# When this variable is missing or still a placeholder the order
# still commits successfully. The notification row stays `pending`
# and the operator sees a clear warning on the admin dashboard and
# in `npm run preflight:orders` so the missing recipient is
# surfaced instead of hidden.
STORE_ORDER_NOTIFICATION_EMAIL=STORE_ORDER_NOTIFICATION_EMAIL_PLACEHOLDER

# -----------------------------------------------------------------------------
# Order notifications — Resend
# -----------------------------------------------------------------------------
# The order backend uses Resend as the transactional email provider.
# The outbox row remains the source of truth: if the API key or
# from-address is missing, the row stays `pending` and the operator
# can retry from the admin dashboard. An order is never rolled back
# because of an email failure.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=RESEND_FROM_PLACEHOLDER
