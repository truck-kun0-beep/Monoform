# =============================================================================
# MONOFORM environment variables
# =============================================================================
#
# Copy this file to `.env.local` and fill in the values for your local
# environment. Never commit `.env.local` or any file containing real
# credentials.
#
# All variables prefixed with `NEXT_PUBLIC_` are exposed to the browser
# bundle by Next.js. Only put values there that are safe to share with
# the public (e.g. Supabase's publishable anon key, the public site URL).
# Service-role keys, private database passwords, and any other secrets
# must NEVER be assigned a `NEXT_PUBLIC_` prefix.

# --- Site ---------------------------------------------------------------------
# Public URL of the storefront. Used to build absolute callback URLs for
# Supabase email flows (verification, password recovery). Defaults to
# `http://localhost:3000` when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase auth ------------------------------------------------------------
# Default authentication provider. The application is wired for Supabase;
# when these values are missing the auth UI renders an honest "Setup
# required" state instead of pretending to work.
#
# Both values are public — the URL identifies the project and the anon
# key is the publishable token designed for the browser. The service-role
# key (a different secret) is never used by this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key

# --- Supabase service role (server-only, never exposed to the browser) ------
# Required by the order backend to perform privileged writes that the
# customer-facing client cannot do through RLS alone (cross-customer reads
# for the admin dashboard, the notification outbox, the order-number
# generator, etc.). This key is read exclusively by server-only modules
# and is never imported from a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# --- Order notifications -----------------------------------------------------
# The order backend commits orders to the database first; the owner
# notification is queued as a database row and then dispatched through
# Resend. A failed email never rolls back an order, and a missing key
# never fabricates a successful delivery.

# Email address that should receive every new-order notification. The
# value is the store owner's mailbox — the application never sends
# order notifications anywhere else. Set this to a real address before
# going live.
STORE_ORDER_NOTIFICATION_EMAIL=[email protected]

# Resend API key used to send the order notification. Keep this secret;
# it is read only by the server-side notification module.
RESEND_API_KEY=re_xxx

# The "from" identity used by Resend. Must be a verified sender on the
# Resend account (a domain or a single address they have authorised).
RESEND_FROM_EMAIL=MONOFORM Orders <[email protected]>
